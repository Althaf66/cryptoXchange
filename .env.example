# Backend (cmd/api, cmd/engine, cmd/websocket)
PORT=:8080
ENV=development
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
DB_ADDR=postgres://admin:adminpassword@localhost/cryptoXchange?sslmode=disable
# Either a bare host:port (no auth, as in docker compose) or a full
# redis://user:password@host:port URL. Managed Valkey/Redis normally requires
# auth, and a bare host:port against it fails with "NOAUTH Authentication
# required" — see internal/rediscfg.
REDIS_ADDR=localhost:6379
JWT_SECRET=change-me

# Engine only: where the order book / balance snapshot is persisted.
SNAPSHOT_PATH=./snapshot.json

# Frontend (frontend/.env.local)
#
# These are inlined into the bundle by `next build`, not read at runtime, so
# they must be present at BUILD time wherever you deploy (see zerops.yml).
# Over HTTPS the socket URL has to be wss:// — a browser blocks ws:// from an
# https page as mixed content, with only a console message to show for it.
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/v1/ws
